{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "name": "mytimer",
      "type": "timerTrigger",
      "direction": "in",
      "schedule": "0 0 8 * * *"
    },
    {
      "name": "outputblob",
      "type": "blob",
      "direction": "out",
      "path": "nba-data/box_scores.json",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
