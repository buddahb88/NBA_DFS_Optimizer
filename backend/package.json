{
  "name": "nba-dfs-optimizer-backend",
  "version": "1.0.0",
  "description": "Backend API for NBA DFS Optimizer",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:backtest": "BACKTESTING_MODE=true nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "start:backtest": "BACKTESTING_MODE=true node src/server.js",
    "init-db": "node src/config/initDb.js",
    "snapshot": "node scripts/snapshot-db.js",
    "backfill": "node scripts/recompute-outcome-ranges.js",
    "enhanced-projections": "node scripts/backfill-enhanced-projections.js",
    "enhanced-projections:update": "node scripts/backfill-enhanced-projections.js --update-db",
    "enhanced-projections:verbose": "node scripts/backfill-enhanced-projections.js --verbose",
    "backfill:site-points": "node scripts/backfill-site-fantasy-points.js",
    "backfill:nba-api": "node scripts/backfill-nba-api.js",
    "backfill:espn": "node scripts/backfill-espn.js",
    "catalog:slates": "node scripts/catalog-live-slates.js",
    "backtest:accuracy": "node scripts/projectionBacktest.js",
    "test:accuracy": "vitest run test/projectionBacktest.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.6.0",
    "@azure/core-auth": "^1.10.1",
    "@azure/openai": "^2.0.0",
    "@langchain/core": "^1.0.4",
    "@langchain/openai": "^1.1.0",
    "axios": "^1.13.2",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "highs": "1.15.3",
    "javascript-lp-solver": "^0.4.24",
    "js-yaml": "^4.1.0",
    "langchain": "^1.0.4",
    "mssql": "^12.2.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.8.1",
    "p-limit": "^7.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "vitest": "^5.0.5"
  }
}
