# Backend environment variables. Copy to backend/.env and fill in.
# Never commit backend/.env - it is gitignored.
#
# NOTE: DATABASE_TYPE, DATABASE_PATH, BACKTESTING_MODE and AZURE_SQL_* are read
# when backend/src/config/database.js is first imported, which happens before
# server.js loads backend/.env. Set those in the real process environment
# (shell, App Service settings) rather than relying on this file.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database ---
# sqlite (default) or azuresql
DATABASE_TYPE=sqlite
# SQLite file path (default: backend/data/nba_dfs.db, or nba_dfs_backtest.db in backtesting mode)
DATABASE_PATH=./data/nba_dfs.db
# true = use the backtest SQLite database
BACKTESTING_MODE=false

# --- Azure SQL (only when DATABASE_TYPE=azuresql) ---
AZURE_SQL_SERVER=nbadfs-sql.database.windows.net
AZURE_SQL_DATABASE=nbadfs
AZURE_SQL_USER=nbadfsadmin
# Required when DATABASE_TYPE=azuresql - the server will refuse to start without it
AZURE_SQL_PASSWORD=

# --- Historical data sync (POST /api/historical/sync) ---
# Scheduled ESPN sync of historical_games: a node-cron expression in server
# local time (5 fields, or 6 with seconds). Each run loads every completed
# game from the latest stored game_date through yesterday, catching up any
# missed days. Runs are recorded in sync_runs (GET /api/historical/sync/status).
# Unset/empty = off (the default; never enabled under tests).
# Example: 06:30 every day, after late West Coast games are final
# HISTORICAL_SYNC_CRON=30 6 * * *
HISTORICAL_SYNC_CRON=

# --- Projection DVP adjustment (services/dvpAdjustment.js) ---
# archetype = opponent x archetype FP over expectation (team_archetype_defense,
# falling back to G/F/C), legacy = old Hashtag points-allowed DVP, off = none
# DVP_ADJUSTMENT_MODE=archetype
# FP added per FP over expectation, and the +/- cap in FP
# DVP_ARCHETYPE_WEIGHT=0.75
# DVP_ARCHETYPE_CAP=2

# --- RotoWire (slate/salary data) ---
ROTOWIRE_COOKIE=your_cookie_here

# --- Azure OpenAI (AI chat) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# Deployment name (default: gpt-4.1-mini)
AZURE_OPENAI_MODEL=gpt-4.1-mini
# API version (default: 2024-04-01-preview)
AZURE_OPENAI_API_VERSION=
